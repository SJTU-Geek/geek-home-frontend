# =============================================
# 思源极协官网 — 环境变量样板
# =============================================
#
# 使用方法：
#   cp .env.example .env
# 然后根据本地实际情况修改 .env。
#
# 注意：
#   - .env 已加入 .gitignore，不会被提交
#   - 只有 vite.config.ts 内部（dev server 配置）读这个文件
#   - 应用代码侧若想消费某个变量，名字必须以 VITE_ 开头才会被注入 import.meta.env

# ---------------------------------------------
# 后端 (Django) base URL —— 仅 dev 模式下生效
# ---------------------------------------------
# Vite dev server 会把 /api 和 /auth 反向代理到这里，
# 让前端 fetch('/auth/me') 实际打到本地 Django。
#
# 生产部署由 nginx 接管反代，不消费此变量。
VITE_BACKEND_BASE=http://127.0.0.1:8000
